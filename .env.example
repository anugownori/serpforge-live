# Required: SerpApi API key. Only set on the server.
SERPAPI_KEY=

# Strongly recommended for public deployments. Give reviewers the site access key separately.
APP_ACCESS_KEY=

# Optional: GitHub token for increased public repository API read limits.
# The app reads source and produces a patch. It NEVER writes to GitHub.
GITHUB_TOKEN=

# Protect SerpApi usage. Each scan uses up to five live SerpApi requests.
MAX_SCANS_PER_HOUR=4
MAX_CONCURRENT_SCANS=2

# For Docker, default /app/data is persisted using a Docker volume.
DATA_DIR=.data
